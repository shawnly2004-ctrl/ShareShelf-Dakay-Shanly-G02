# Copy this file to .env and replace each placeholder with your own values.
# Never commit your real .env file or share its secrets.
SECRET_KEY=replace-with-a-private-django-secret-key
DEBUG=True
DB_NAME=postgres
DB_USER=your-supabase-database-user
DB_PASSWORD=your-supabase-database-password
DB_HOST=your-supabase-pooler-host
DB_PORT=5432
